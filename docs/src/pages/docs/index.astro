---
import Layout from '../../components/Layout.astro';
import Header from '../../components/Header.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sections = [
  {
    name: 'Tutorials',
    description: 'Step-by-step paths from zero to a working machine.',
    docs: [
      { slug: 'getting-started', title: 'Getting Started' },
      { slug: 'xstate-migration', title: 'Migration from XState' },
      { slug: 'migration-from-looplab-fsm', title: 'Migration from looplab/fsm' },
      { slug: 'migration-from-qmuntal-stateless', title: 'Migration from qmuntal/stateless' },
      { slug: 'tdd', title: 'Test-Driven Development' },
    ],
  },
  {
    name: 'How-to guides',
    description: 'Task-oriented recipes — when you know what you want.',
    docs: [
      { slug: 'choosing-an-api', title: 'Choosing an API' },
      { slug: 'hierarchical-states', title: 'Hierarchical States' },
      { slug: 'guards-actions', title: 'Guards & Actions' },
      { slug: 'reflection-dsl', title: 'Reflection DSL' },
      { slug: 'code-generation', title: 'Code Generation' },
      { slug: 'visualization', title: 'Visualization' },
      { slug: 'testing', title: 'Testing' },
      { slug: 'http-integration', title: 'HTTP Integration' },
      { slug: 'observability', title: 'Observability' },
      { slug: 'opentelemetry', title: 'OpenTelemetry' },
      { slug: 'lint', title: 'Static Analysis (Lint)' },
      { slug: 'plugin-system', title: 'Plugin System' },
      { slug: 'machine-composition', title: 'Machine Composition' },
      { slug: 'actor-persistence', title: 'Actor Persistence' },
      { slug: 'performance-tuning', title: 'Performance Tuning' },
    ],
  },
  {
    name: 'Reference',
    description: 'Facts, contracts, stability promises.',
    docs: [
      { slug: 'api-reference', title: 'API Reference' },
      { slug: 'stability', title: 'API Stability Tiers' },
      { slug: 'patterns-recipes', title: 'Patterns & Recipes' },
    ],
  },
];
---

<Layout
  title="Documentation · Statekit"
  description="Statekit documentation organized by Diataxis: tutorials, how-to guides, reference, and explanations."
  canonical="/docs/"
>
  <div class="docs-shell">
    <Header active="docs" />

    <main class="docs-index">
      <header class="docs-index-hero">
        <h1>Documentation</h1>
        <p class="docs-index-lede">
          Organized by <a href="https://diataxis.fr/" target="_blank" rel="noopener">Diataxis</a> — the type of doc you need depends on whether you're learning, doing, looking up, or understanding.
        </p>
      </header>

      <div class="docs-index-grid">
        {sections.map((section) => (
          <section class="docs-index-section">
            <h2>{section.name}</h2>
            <p class="docs-index-section-desc">{section.description}</p>
            <ul>
              {section.docs.map((d) => (
                <li>
                  <a href={`${base}/docs/${d.slug}`}>{d.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </main>
  </div>
</Layout>

<style>
  .docs-shell {
    min-height: 100vh;
    background: var(--bg);
  }

  .docs-index {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  .docs-index-hero h1 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0 0 0.5rem;
  }

  .docs-index-lede {
    color: var(--text-secondary);
    margin: 0 0 2rem;
    max-width: 60ch;
  }

  .docs-index-lede a {
    color: var(--accent-cyan);
  }

  .docs-index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .docs-index-section {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .docs-index-section h2 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
    color: var(--accent-cyan);
  }

  .docs-index-section-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }

  .docs-index-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .docs-index-section a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    display: block;
    padding: 0.25rem 0;
  }

  .docs-index-section a:hover {
    color: var(--accent-cyan);
  }
</style>
