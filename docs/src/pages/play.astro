---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Visualizer from '../components/Visualizer.vue';
---

<Layout
  title="Statekit Visualizer — Try Statecharts in the Browser"
  description="Paste Statekit Native JSON and visualize, simulate, and step through your state machine in the browser."
  canonical="/play"
>
  <div class="app">
    <Header active="play" />
    <Visualizer client:idle />
  </div>
</Layout>

<style>
  .app {
    display: grid;
    grid-template-columns: 320px 1fr;
    grid-template-rows: auto 1fr;
    height: 100vh;
    background: var(--bg);
  }

  :global(.visualizer-content) {
    display: contents;
  }
</style>
